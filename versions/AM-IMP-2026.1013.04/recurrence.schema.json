{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frequency"
  ],
  "properties": {
    "frequency": {
      "enum": [
        "DAILY",
        "WEEKLY",
        "MONTHLY"
      ]
    },
    "interval": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "weekdays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SU",
          "MO",
          "TU",
          "WE",
          "TH",
          "FR",
          "SA"
        ]
      }
    },
    "until": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "not": {
    "required": [
      "until",
      "count"
    ]
  }
}